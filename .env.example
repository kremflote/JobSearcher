# Kopier til .env og fyll inn. .env er gitignored.

# Gmail SMTP: brukes til å sende digest-e-post til deg selv.
# (Ingen IMAP lenger — Finn-flyten går via mobil-API, se spike 04.)
GMAIL_ADDRESS=
# 16-tegns app-passord fra https://myaccount.google.com/apppasswords (uten mellomrom)
GMAIL_APP_PASSWORD=

# Privat token for NAV pam-stilling-feed
NAV_FEED_TOKEN=

# Valgfri: bare hvis llm.backend = anthropic_api
ANTHROPIC_API_KEY=

# Drift i container (fase 4b): token fra `claude setup-token`, så `claude -p` bruker abonnementet.
CLAUDE_CODE_OAUTH_TOKEN=

# Valgfrie stier (standard: data/, context/profile/, context/derived/). I container: /data, /data/profile, /data/derived.
# DATA_DIR=
# PROFILE_DIR=
# DERIVED_DIR=
# Sett til false for å slå av den daglige kjøringen i `serve`.
# SCHEDULER_ENABLED=true
