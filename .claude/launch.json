{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "jobsearcher",
        "serve"
      ],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}