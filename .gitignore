# Hemmeligheter
.env

# Kjøretidsdata (DB, cache, logger, bedriftsnotater)
data/

# Generert kontekst
context/derived/*
!context/derived/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Obsidian: lokal arbeidsflate-tilstand
.obsidian/workspace*.json

# Personlig profil (persondata), bare malene versjoneres
context/profile/**
!context/profile/**/
!context/profile/**/_template.md

# Ekte e-poster/data brukt som testgrunnlag (persondata)
tests/fixtures/private/

# Finn Android-APK (brukes lokalt for reverse engineering, se spike 04)
*.apk

# Frontend (web/)
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
